{
  "name": "buster",
  "version": "4.4.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "@jimp/custom": "^0.22.12",
    "@jimp/plugin-fisheye": "^1.6.0",
    "@jimp/plugins": "^0.22.12",
    "@jimp/types": "^1.6.0",
    "@sapphire/decorators": "^6.2.0",
    "@sapphire/discord-utilities": "^3.5.0",
    "@sapphire/discord.js-utilities": "^7.3.3",
    "@sapphire/fetch": "^3.0.5",
    "@sapphire/framework": "^5.3.6",
    "@sapphire/pieces": "^4.4.1",
    "@sapphire/plugin-api": "^8.3.1",
    "@sapphire/plugin-editable-commands": "^4.0.4",
    "@sapphire/plugin-scheduled-tasks": "^10.0.3",
    "@sapphire/plugin-subcommands": "^7.0.1",
    "@sapphire/stopwatch": "^1.5.4",
    "@sapphire/time-utilities": "^1.7.14",
    "@sapphire/type": "^2.6.0",
    "@sapphire/utilities": "^3.18.2",
    "@skyra/editable-commands": "^3.0.4",
    "bullmq": "^5.56.9",
    "chrono-node": "^2.8.4",
    "discord-api-types": "^0.38.18",
    "discord.js": "^14.21.0",
    "gifencoder": "^2.0.1",
    "gm": "^1.25.1",
    "googleapis": "^154.1.0",
    "ioredis": "^5.7.0",
    "jimp": "^1.6.0",
    "puppeteer": "^24.15.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-adblocker": "^2.13.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.34.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.3",
    "@sapphire/cli": "^1.9.3",
    "@sapphire/ts-config": "^5.0.1",
    "@types/bun": "^1.2.19",
    "@types/gifencoder": "^2.0.3",
    "@types/gm": "^1.25.4",
    "@types/puppeteer": "^7.0.4",
    "@types/sharp": "^0.32.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.1.0",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "build": "tsc --noEmit && bun build --compile --minify --sourcemap --bytecode src/main.ts src/assets/**/* --outfile dist/buster",
    "start": "./dist/buster",
    "dev": "concurrently \"bun run tsc --noEmit --watch\" \"bun run src/main.ts --watch\" --names \"tsc,bun\" --prefix-colors \"blue,green\"",
    "dev:debug": "bun run src/main.ts --watch --inspect",
    "redis:gui": "redis-commander --redis-host redis",
    "format": "biome format --write .",
    "lint": "biome lint --write ."
  }
}
